unit ServerMethodsUnit1;

interface

uses System.SysUtils, System.Classes, System.Json,
    DataSnap.DSProviderDataModuleAdapter,
    Datasnap.DSServer, Datasnap.DSAuth,
    DateUtils,
    Rest.Json,
    uPessoa.Model;
type
  TServerMethods1 = class(TDSServerModule)
  private
    { Private declarations }
  public
    { Public declarations }
    function EchoString(Value: string): string;
    function ReverseString(Value: string): string;
    function SayMyName: string;

    function GetPessoaNativo: TPessoa;
    function GetPessoaNativo: Boolean;
    function GetPessoaNaoNativo: string;
    function GetPessoaNaoNativoJO: TJSONObject;
  end;

implementation


{$R *.dfm}


uses System.StrUtils;

function TServerMethods1.EchoString(Value: string): string;
begin
  Result := Value;
end;

function TServerMethods1.GetPessoaNaoNativo: string;
begin
  var lPessoa := TPessoa.Create;
  try
    lPessoa.ID := 2;
    lPessoa.Nome := 'Server Pessoa não nativo';
    lPessoa.DataNascimento := IncYear(now, -22);
    lPessoa.Renda := 222.34;
    lPessoa.Ativo := False;

    Result := TJson.ObjectToJsonString(lPessoa);
  finally
    lPessoa.Free;
  end;
end;

function TServerMethods1.GetPessoaNaoNativoJO: TJSONObject;
begin
  var lPessoa := TPessoa.Create;
  try
    lPessoa.ID := 3;
    lPessoa.Nome := 'Server Pessoa não nativo JsonObject';
    lPessoa.DataNascimento := IncYear(now, -28);
    lPessoa.Renda := 822.34;
    lPessoa.Ativo := False;

    Result := TJson.ObjectToJsonObject(lPessoa);
  finally
    lPessoa.Free;
  end;
end;

function TServerMethods1.GetPessoaNativo: TPessoa;
begin
  Result := TPessoa.Create;
  Result.ID := 1;
  Result.Nome := 'Server Pessoa - Nativo';
  Result.DataNascimento := IncYear(Now, -32);
  Result.Renda := 54321;
  Result.Ativo := True;
end;

function TServerMethods1.ReverseString(Value: string): string;
begin
  Result := System.StrUtils.ReverseString(Value);
end;

function TServerMethods1.SayMyName: string;
begin
  Result := 'Daniel';
end;

end.

