function TServerMethods1.SetPessoaNaoNativo(APessoa: string): Boolean;
begin
  Result := False;
  var lPessoa := TJson.JsonToObject<TPessoa>(APessoa);

  var jsonObj := TJson.ObjectToJsonString(lPessoa);

  var stl := TStringList.Create;
  try
    stl.Add(jsonObj);
    stl.SaveToFile('log-pessoa.json', TEncoding.UTF8);
  finally
    stl.Free;
  end;

  Result := True;
end;

function TServerMethods1.SetPessoaNativo(APessoa: TPessoa): Boolean;
begin
