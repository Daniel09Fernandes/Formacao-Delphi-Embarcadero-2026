procedure TFrmMain.BtnmSerealizarClick(Sender: TObject);
const
  DATA_NASCIMENTO = '11/04/1994';
begin
  var lPessoa := TPessoa.Create;
  try
    lPessoa.ID := 0;
    lPessoa.Nome := 'Daniel';
    lPessoa.DataNascimento := StrToDate(DATA_NASCIMENTO);
    lPessoa.Renda := 1500;
    lPessoa.Ativo := True;

    var lPayload := TJson.ObjectToJsonString(lPessoa);
    MJson.Lines.Add(lPayload);
