procedure TFrmMain.mDadosExit(Sender: TObject);
begin
  if string(mDados.Text).Trim.IsEmpty then
    Exit;

  var lHash := THashSHA2.GetHashString(mDados.Text);
  mHash.Lines.Add(lHash);
end;

{ TSmartWrapper<T> }

function TSmartWrapper<W>.New(AOWn: W): W;
begin
  if AOWn <> nil then
    Result := AOWn
  else
    Result := W.Create;

  SmartP := Result;
end;

end.
