procedure TFrmMain.Button4Click(Sender: TObject);
begin
  var lHash := THashSHA2.GetHashString(EdtSenha.Text + 'Aula 2026');

  var lResponseAuth :=
    ClientModule1.ServerMethods1Client.AutenticarUsuario(lHash);

   mHashServer.Lines.Add(lResponseAuth);
