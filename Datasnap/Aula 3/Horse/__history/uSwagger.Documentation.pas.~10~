unit uSwagger.Documentation;

interface

uses
  SysUtils,
  Classes,
  Horse,
  Horse.GBSwagger,
  uModel.ErrorAPI;

procedure DocumentationAPI;
procedure WriteRouteAPI(APort: Integer);

implementation

procedure WriteRouteAPI(APort: Integer);
const
  SWAGGER_URL = 'http://localhost:%s/swagger/doc/html';
begin
  Writeln(
    Format(SWAGGER_URL, [APort])
  );
end;

procedure DocumentationAPI;
begin
  THorse.Use(HorseSwagger);

  Swagger
    .Register
      .SchemaOnError(TErrorApiModel)
    .&End
    .Info
      .Title('API Aula 3')
      .Description('API em Horse')
      .Contact
        .Name('Contact DinosDev')
        .Email('DinosDev@email.com.br')
        .URL('http://www.DinosDev.com.br')
      .&End
    .&End
    .BasePath('v1');
end;

end.
