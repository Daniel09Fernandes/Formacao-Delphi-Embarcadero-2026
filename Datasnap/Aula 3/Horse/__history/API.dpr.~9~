program API;

{$APPTYPE CONSOLE}

{$R *.res}

uses
  System.SysUtils,
  Horse,
  uController.Login in 'Controller\uController.Login.pas',
  uSwagger.Documentation in 'uSwagger.Documentation.pas',
  uModel.ErrorAPI in 'Model\uModel.ErrorAPI.pas';

begin
  try
    const
      HORSE_PORT = 9002;

    DocumentationAPI;
    WriteRouteAPI(HORSE_PORT);
