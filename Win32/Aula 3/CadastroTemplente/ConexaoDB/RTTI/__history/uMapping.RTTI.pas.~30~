unit uMapping.RTTI;

interface

uses
  System.Generics.Collections,
  SysUtils, StrUtils, Classes,
  Data.DB,
  Datasnap.DBClient,
  System.RTTI,
  System.Types;

type
  TParamWhere = record
    Field: string;
    Operation: string;
    Value: Variant;
  end;

  TWhere = TList<TParamWhere>;

  TMappingRTTI<T: class, constructor> = class
  public
    function GetListObject(AWhere: TWhere = nil): TObjectList<T>;
    function ObjectListToCds(AList: TObjectList<T>): TClientDataSet;
  end;

implementation

{ TMappingRTTI<T> }

uses
  uDBMapping.Attributes, uDM.Connection, VarUtils, Variants;


function TMappingRTTI<T>.GetListObject(AWhere: TWhere): TObjectList<T>;
var
  //RTTI
  lCtx: TRttiContext;
  lRttiClass: TRttiType;
  lRttiProperty: TRttiProperty;

  //Var Geral
  lField: string;
  lTable: string;
  lItem: T;
  lValue: TValue;
begin
   lRttiClass := lCtx.GetType(TypeInfo(T)); // Pega as informações da classe informada em T
                                           // EX: TMappingRTTI<TLoginModel>
                                           //     T sera = a TLoginModel
   lField := ' 0';

   //Pega os atributos da classe
   for var lAtrtibute in lRttiClass.GetAttributes do
   begin
     if lAtrtibute is TMappingTable then
       lTable := TMappingTable(lAtrtibute).TableName;
   end;

   for lRttiProperty in lRttiClass.GetProperties do
   begin
      if Assigned(lRttiProperty) then
      begin
        for var lAttributesProp in lRttiProperty.GetAttributes do
        begin
           if lAttributesProp is TMappingField then
             lField := lField + ', '+
                TMappingField(lAttributesProp).FieldName;           
        end;
      end;
   end;

   Result := TObjectList<T>.Create;

   DMConnection.QryRTTI.Close;
   DMConnection.QryRTTI.SQL.Clear;
   DMConnection.QryRTTI.SQL.Add('select  '+ lField + ' from '+ lTable +' ');

   if Assigned(AWhere) then
   begin
     DMConnection.QryRTTI.SQL.Add(' where ');

     for var lPair in AWhere do
        DMConnection.QryRTTI.SQL.Add(
          lPair.Field + ' ' +lPair.Operation + VarToStr(lPair.Value) +' and' ); 

     DMConnection.QryRTTI.SQL.Add('1 = 1');
   end;  

   DMConnection.QryRTTI.Open();
   try 
     var lQry := DMConnection.QryRTTI;     
     DMConnection.QryRTTI.First;

     while not lQry.Eof do
     begin
       lItem := T.Create;

       for lRttiProperty in lRttiClass.GetProperties do
       begin
         if Assigned(lRttiProperty) then
         begin
           for var lAttributesProp in lRttiProperty.GetAttributes do
           begin
              if lAttributesProp is TMappingField then
              begin
                 case lRttiProperty.PropertyType.TypeKind of
                   tkInteger, tkInt64:
                     begin  
                       lValue := TValue.From<Integer>(
                          lQry.FieldByName(
                              TMappingField(lAttributesProp).FieldName
                            ).AsInteger
                         );
                     end;
                   tkFloat:
                     begin  
                        if lRttiProperty.PropertyType.Handle = TypeInfo(TDateTime) then
                        begin
                           lValue := TValue.From<TDateTime>(
                                lQry.FieldByName(
                                   TMappingField(lAttributesProp).FieldName
                               ).AsDateTime);
                        end;
                        
                     end;
                 end;
              end;
           end;
         end;                
       end;              
       lQry.Next;
     end;
   
   finally
     DMConnection.QryRTTI.Close;
   end;
end;

function TMappingRTTI<T>.ObjectListToCds(AList: TObjectList<T>): TClientDataSet;
begin

end;

end.
