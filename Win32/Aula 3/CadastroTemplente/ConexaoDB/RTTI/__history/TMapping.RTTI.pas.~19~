unit TMapping.RTTI;

interface

uses
  System.Generics.Collections,
  SysUtils, StrUtils, Classes,
  Data.DB,
  Datasnap.DBClient,
  System.RTTI,
  System.Types;

type
  TParamWhere = record
    FirstKey: string;
    Operation: string;
    Value: Variant;
  end;

  TWhere = TList<TParamWhere>;

  TMappingRTTI<T: class, constructor> = class
  public
    function GetListObject(AWhere: TWhere = nil): TObjectList<T>;
    function ObjectListToCds(AList: TObjectList<T>): TClientDataSet;
  end;

implementation

{ TMappingRTTI<T> }

uses
  uDBMapping.Attributes, uDM.Connection;


function TMappingRTTI<T>.GetListObject(AWhere: TWhere): TObjectList<T>;
var
  //RTTI
  lCtx: TRttiContext;
  lRttiType: TRttiType;


  //Var Geral
  lField: string;
  lTable: string;
begin
   lRttiType := lCtx.GetType(TypeInfo(T)); // Pega as informações da classe informada em T
                                           // EX: TMappingRTTI<TLoginModel>
                                           //     T sera = a TLoginModel
   lField := ' 0';

   var lArrayAtributes :=  lRttiType.GetAttributes;

   for var lAtrtibute in lArrayAtributes do
   begin
     if lAtrtibute is TMappingTable then
       lTable := TMappingTable(lAtrtibute).TableName
     else
       if lAtrtibute is TMappingField then
         lField := lField + ', '+ TMappingField(lAtrtibute).FieldName;
   end;
end;

function TMappingRTTI<T>.ObjectListToCds(AList: TObjectList<T>): TClientDataSet;
begin

end;

end.
