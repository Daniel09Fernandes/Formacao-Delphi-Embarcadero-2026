unit uDialog;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, System.Skia,
  FMX.Memo.Types, FMX.StdCtrls, FMX.Controls.Presentation, FMX.ScrollBox,
  FMX.Memo, FMX.Skia, FMX.Objects, System.ImageList, FMX.ImgList;

type
  TDialogType = (dInfo, dAlert, dError, dQuest);

  TFrDialog = class(TForm)
    RContext: TRectangle;
    RHeader: TRectangle;
    LblTitle: TSkLabel;
    SkAnimatedImage1: TSkAnimatedImage;
    MMsg: TMemo;
    Rectangle2: TRectangle;
    BtnOK: TButton;
    BtnNo: TButton;
    ImageList1: TImageList;
    procedure BtnNoClick(Sender: TObject);
    procedure BtnOKClick(Sender: TObject);
  private
    class var FInstance: TFrDialog;
  public
    class function ShowMessage(AMsg: String; ADlgType: TDialogType = dInfo): Boolean;
  end;

implementation

{$R *.fmx}

procedure TFrDialog.BtnNoClick(Sender: TObject);
begin
  Close;
  ModalResult := mrCancel;
end;

procedure TFrDialog.BtnOKClick(Sender: TObject);
begin
  Close;
  ModalResult := mrOk;
end;

class function TFrDialog.ShowMessage(AMsg: String;
  ADlgType: TDialogType): Boolean;
begin
  FInstance := TFrDialog.Create(nil);
  try
    Result := FInstance.ShowModal = mrOk;
  finally
    FInstance.Free;
  end;
end;

end.
