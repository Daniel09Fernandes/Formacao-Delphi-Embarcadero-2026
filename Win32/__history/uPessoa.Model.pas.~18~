unit uPessoa.Model;

interface

type
  TPessoa  = class
  strict private
    FNome: string;
    FEndereco: string;
    FTelefone: string;
  strict protected
    property Nome: string read FNome write FNome;
    property Endereco: string read FEndereco write FEndereco;
    property Telefone: string read FTelefone write FTelefone;

  published

  public

    function AplicarMascaraNoIdentificador(AValue: string): string;
  end;

  TClasseAmiga = class
  private

  public
    procedure TesteOOP;
  end;

implementation

{ TPessoa }

uses
  MaskUtils;

function TPessoa.AplicarMascaraNoIdentificador(AValue: string): string;
begin
  Result := FormatMaskText('000\.000.\000\-00;0;', AValue);
end;

{ TClasseAmiga }

procedure TClasseAmiga.TesteOOP;
begin
  var lPessoa := TPessoa.Create;
  try
    //lPessoa.FNome := ''; // Passa a dar erro, devido ao uso do strict
  finally
    lPessoa.Free;
  end;
end;

end.
