unit uNotificacao.View;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls;

type
  TFrmNotificacao = class(TForm)
    Button1: TButton;
    Button2: TButton;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

implementation

{$R *.dfm}

uses
  uNotificacao.Controller;

procedure TFrmNotificacao.Button1Click(Sender: TObject);
begin
  var iNotificacao := TNotificacaoController.New(tpSMS);
  iNotificacao.EnviarNotificacao('Envio essa msg para mostrar como a interface funciona');
  iNotificacao.ReceberNotificacao('OK, Notificacao recebida!');
end;

procedure TFrmNotificacao.Button2Click(Sender: TObject);
begin
  TNotificacaoController
    .New(tpWhatsApp)
      .EnviarNotificacao('Envio essa msg para mostrar como o segundo jeito de usar a interface funciona - Fluent Interface')
      .ReceberNotificacao('OK Fluent interface aprendido!')
      .ReceberNotificacao('Teste');
end;

end.
