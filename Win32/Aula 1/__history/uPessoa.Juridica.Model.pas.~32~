function TPessoaJuridica.AplicarMascaraNoIdentificador(AValue: string): string;
begin

  Result := FormatMaskText('00\.000.\000\/0000-00;0;', AValue);
 // Result := inherited;
end;

function TPessoaJuridica.CalcularBonusSalario(ASalario, ABonus: Double): Double;
begin
  Result := ASalario * ABonus;
end;

function TPessoaJuridica.CalcularBonusSalario(ASalario, ABonus: string): Double;
var
  OutSalario: Double;
  OutBonus: Double;
begin
  if (TryStrToFloat(ASalario, OutSalario)) and
     (TryStrToFloat(ABonus, OutBonus)) then
    Result := CalcularBonusSalario(OutSalario, OutBonus)
  else
    raise Exception.Create('Erro ao calcular o bonus do salario!');
end;

function TPessoaJuridica.GetCNPJ: string;
begin
  Result := AplicarMascaraNoIdentificador(FCNPJ);
end;

procedure TPessoaJuridica.SetCNPJ(const Value: string);
begin
  if Value.Length < 14 then
    raise Exception.Create('CNPJ Invalido');

  FCNPJ := Value;
end;

end.
