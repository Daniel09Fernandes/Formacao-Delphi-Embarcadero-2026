procedure TForm1.Button1Click(Sender: TObject);
  function ExecutarOperacao(X, Y: Double; AFunc: TOperacao): Double;
  begin
     Result := AFunc(X, Y);
  end;
begin
  var lNum1:Double := NumberBox1.Value;
  var lNum2:Double := NumberBox2.Value;
  Memo1.Clear;

  Var Retorno: Double;

  Retorno := ExecutarOperacao(lNum1, lNum2,
                                        function (X, Y: double): double
                                        begin
                                          Result := X+ Y;
                                        end);

  Memo1.Lines.Add('A Soma: '+ Retorno.ToString);

    Retorno := ExecutarOperacao(lNum1, lNum2,
                                        function (X, Y: double): double
                                        begin
                                          Result := X - Y;
                                        end);

  Memo1.Lines.Add('A Subitracao: '+ Retorno.ToString);


  Retorno := ExecutarOperacao(lNum1, lNum2,
                                        function (X, Y: double): double
                                        begin
                                          Result := X / Y;
                                        end);

  Memo1.Lines.Add('A Divisao: '+ Retorno.ToString);


  Retorno := ExecutarOperacao(lNum1, lNum2,
                                        function (X, Y: double): double
                                        begin
                                          Result := X * Y;
                                        end);

  Memo1.Lines.Add('A Multiplicacao: '+ Retorno.ToString);
end;

