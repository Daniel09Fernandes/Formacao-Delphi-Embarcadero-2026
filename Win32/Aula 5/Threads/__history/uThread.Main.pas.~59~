function GetProc(AGauge: TGauge): TProc;
  begin
    Result :=
      procedure
      begin
        for var i := 0 to 100 do
        begin
          TThread.NameThreadForDebugging('Gauge'+ i.ToString);

          TThread.Synchronize(nil,
          procedure
          begin
             AGauge.MaxValue := 100;
             AGauge.Progress := i;
          end);
        end;
      end
  end;

