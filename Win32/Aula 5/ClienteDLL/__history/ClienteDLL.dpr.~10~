program ClienteDLL;

{$APPTYPE CONSOLE}

{$R *.res}

uses
  System.SysUtils,
  Winapi.Windows;

var
  Soma: function(A, B: Double): Double; stdcall;

  hdll: THandle;
begin
  try
    hdll := LoadLibrary('CalculoDLL.dll');
    @Soma := GetProcAddress(hdll, 'Soma');

    var lNum1, lNum2: Double;
    Readln(lNum1);
    Readln(lNum2);
    Writeln('');

    Write('O Resultado da soma: '+ Soma(LNum1, lNum2).ToString);


    Readln;
  except
    on E: Exception do
      Writeln(E.ClassName, ': ', E.Message);
  end;
end.
