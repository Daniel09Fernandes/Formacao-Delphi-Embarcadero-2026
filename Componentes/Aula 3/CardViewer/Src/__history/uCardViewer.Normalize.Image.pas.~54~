unit uCardViewer.Normalize.Image;

interface

uses
  Classes, SysUtils, vcl.Graphics, vcl.Imaging.GIFImg, vcl.Imaging.jpeg,
  vcl.Imaging.pngimage;

type
  TNormalizeImage = class
  private
     class function FindImages(const Buffer; const BufferSize: Int64;
       out Graphic: TGraphicClass): Boolean; overload;

     class function FindImages(const AStream: TStream;
       out Graphic: TGraphicClass): Boolean; overload;
  public
     class function GetImage(AFile: string): TGraphic; overload;
     class function GetImage(AStream: TStream): TGraphic; overload;
  end;

implementation

const
  MIN_SIZE = 44;

  I_BITMAP = $4D42;
  I_JPEG = $D8FF;
  I_TIFF_1 = $4949;
  I_TIFF_2 = $4D4D;
  I_PNG =  $A1A0A0D474E5089;
  I_METAFILE_POS_0 = $9AC6CDD7;
  I_METAFILE_POS_10 = $464D4520;
  I_GIF = 'GIF';
  I_ICON = 1;

{ TNormalizeImage }

class function TNormalizeImage.FindImages(const Buffer; const BufferSize: Int64;
  out Graphic: TGraphicClass): Boolean;
var
  LongWords: array[Byte] of LongWord absolute Buffer;
  Words: array[Byte] of Word absolute Buffer;
begin
  Graphic := nil;
  Result := False;

  if BufferSize < MIN_SIZE then
    Exit(False);

  case Words[0] of
    I_BITMAP: Graphic := TBitmap;
    I_JPEG: Graphic := TJPEGImage;
    I_TIFF_1: Graphic := TWICImage;
    I_TIFF_2: Graphic := TWICImage;
    else
    begin
      if Int64(Buffer) = I_PNG then
      begin
        Graphic := TPngImage;
      end
      else
        if (LongWords[0] = I_METAFILE_POS_0) or
           ((LongWords[0] = 1) and (LongWords[10]  = I_METAFILE_POS_10 ))
        then
        begin
          Graphic := TMetafile;
        end
        else
          if StrLComp(PAnsiChar(@Buffer), I_GIF, 3) = 0 then
          begin
            Graphic := TGIFImage;
          end
          else
            If Words[1] = I_ICON then
              Graphic := TIcon;
    end;
  end;

  Result := (Graphic <> nil);
end;

class function TNormalizeImage.FindImages(const AStream: TStream;
  out Graphic: TGraphicClass): Boolean;
begin
  var lBuffer: PByte;
  var lPos: Int64;

  if AStream is TCustomMemoryStream then
  begin
    lBuffer := TCustomMemoryStream(AStream).Memory;
    lPos := AStream.Position;

    Inc(lBuffer, lPos);

    Result := FindImages(lBuffer^, AStream.Size - lPos, Graphic);
    Exit;
  end;

  GetMem(lBuffer, MIN_SIZE);
  try
    var ByteRead := AStream.Read(lBuffer^, MIN_SIZE);
    AStream.Seek(-ByteRead, soCurrent);
    Result := FindImages(lBuffer^, ByteRead, Graphic);
  finally
    FreeMem(lBuffer);
  end;
end;

class function TNormalizeImage.GetImage(AStream: TStream): TGraphic;
var
  lGraphics: TGraphicClass;
begin
  Result := nil;
  AStream.Position := 0;

  if FindImages(AStream, lGraphics) then
  begin

  end;
end;

class function TNormalizeImage.GetImage(AFile: string): TGraphic;
var
  lStrStream: TStringStream;
begin
  lStrStream := TStringStream.Create;
  try
    lStrStream.LoadFromFile(AFile);
    Result := GetImage(lStrStream);
  finally
    lStrStream.Free;
  end;
end;

end.
